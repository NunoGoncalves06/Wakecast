<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 DayNight. On Android 12+ the colours are replaced at runtime by the
        wallpaper's (Material You) or by a palette generated from the colour picked in
        Settings > Appearance. These are the fallback for older phones.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#5F33E1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E7DEFF</item>
        <item name="colorOnPrimaryContainer">#1D0060</item>
        <item name="colorSecondaryContainer">#E6DFF9</item>
        <item name="colorOnSecondaryContainer">#1E192B</item>
        <item name="materialTimePickerTheme">@style/TimePickerTheme</item>
    </style>

    <!-- The time picker's Cancel / OK buttons use the primary colour. -->
    <style name="TimePickerTheme" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="borderlessButtonStyle">@style/TimePickerButton</item>
    </style>

    <style name="TimePickerButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
